@{
    ViewData["Title"] = "Iniciar sesión";
}
<div class="row justify-content-center align-items-center py-3">
    <div class="col-lg-10">
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-6 d-none d-lg-block">
                <div class="page-hero h-100 d-flex flex-column justify-content-between">
                    <div>
                        <span class="badge bg-white text-primary mb-3">Bienvenido de nuevo</span>
                        <h2 class="fw-bold mb-3">Accede a tu entorno académico en un solo lugar</h2>
                        <p class="mb-4 opacity-75">Consulta clases, reproduce videos, registra excusas y mantente al día con tus materias favoritas.</p>
                    </div>
                    <ul class="list-unstyled mb-0 small opacity-90">
                        <li class="mb-2"><i class="bi bi-play-circle-fill me-2"></i>Videos disponibles para cada clase</li>
                        <li class="mb-2"><i class="bi bi-envelope-paper-fill me-2"></i>Envío rápido de excusas</li>
                        <li><i class="bi bi-shield-check me-2"></i>Acceso seguro por rol</li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="app-card p-4 p-lg-5 h-100">
                    <div class="text-center mb-4">
                        <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3" style="width:54px;height:54px;">
                            <i class="bi bi-door-open-fill fs-4 text-primary"></i>
                        </div>
                        <h3 class="mb-1">Iniciar sesión</h3>
                        <p class="text-muted mb-0">Accede a tus clases, videos y excusas desde un solo lugar.</p>
                    </div>
                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Correo</label>
                            <input name="email" class="form-control" placeholder="usuario@iue.edu.co" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Contraseña</label>
                            <input name="password" type="password" class="form-control" required />
                        </div>
                        <div asp-validation-summary="All" class="text-danger small"></div>
                        <button class="btn btn-primary w-100">Entrar</button>
                    </form>
                    <p class="mt-3 mb-0 small text-muted">¿No tienes cuenta? <a asp-action="Register">Regístrate aquí</a></p>
                    <div class="alert alert-info mt-3 mb-0 small rounded-4">
                        Credenciales de prueba:<br />
                        <strong>admin@iue.edu.co</strong> / <strong>Admin123!</strong><br />
                        <strong>profesor@iue.edu.co</strong> / <strong>Profesor123!</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
