@using IUE.DesatrasadorMVP.Models
@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Panel de administración";
    var roles = (IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>)ViewBag.Roles;
    var profesores = (IEnumerable<ApplicationUser>)ViewBag.Profesores;
    var estudiantes = (IEnumerable<ApplicationUser>)ViewBag.Estudiantes;
    var materias = (IEnumerable<Materia>)ViewBag.Materias;
}
<div class="row g-4">
    <div class="col-12">
        <div class="page-hero">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <span class="badge bg-white text-primary mb-3">Administración</span>
                    <h3 class="mb-2">Panel de administración</h3>
                    <p class="mb-0 opacity-75">Gestiona roles, profesores, estudiantes y materias desde un solo lugar.</p>
                </div>
                <div class="text-white-50 small">@profesores.Count() profesores · @estudiantes.Count() estudiantes</div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="stat-card p-4">
                    <div class="text-muted small">Profesores activos</div>
                    <div class="display-6 fw-bold text-primary">@profesores.Count()</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card p-4">
                    <div class="text-muted small">Estudiantes</div>
                    <div class="display-6 fw-bold text-success">@estudiantes.Count()</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card p-4">
                    <div class="text-muted small">Materias configuradas</div>
                    <div class="display-6 fw-bold text-info">@materias.Count()</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="app-card p-4 h-100">
            <h5 class="mb-3"><i class="bi bi-person-plus-fill me-2 text-success"></i>Crear profesor</h5>
            <form asp-action="CrearProfesor" method="post" class="vstack gap-2">
                <input class="form-control" name="nombreCompleto" placeholder="Nombre completo" required />
                <input class="form-control" name="email" type="email" placeholder="Correo@iue.edu.co" required />
                <input class="form-control" name="password" type="password" placeholder="Contraseña temporal" required />
                <button class="btn btn-success">Agregar profesor</button>
            </form>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="app-card p-4 h-100">
            <h5 class="mb-3"><i class="bi bi-people-fill me-2 text-primary"></i>Estudiantes</h5>
            <div class="vstack gap-2">
                @foreach (var estudiante in estudiantes)
                {
                    <div class="border rounded-4 p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@estudiante.NombreCompleto</strong><br />
                            <small class="text-muted">@estudiante.Email</small>
                        </div>
                        <form asp-action="EliminarEstudiante" method="post">
                            <input type="hidden" name="userId" value="@estudiante.Id" />
                            <button class="btn btn-outline-danger btn-sm">Eliminar</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="app-card p-4 h-100">
            <h5 class="mb-3"><i class="bi bi-shield-lock-fill me-2 text-warning"></i>Asignar roles</h5>
            <div class="table-responsive">
                <table class="table table-sm align-middle table-modern">
                    <thead><tr><th>Usuario</th><th>Rol</th><th>Acción</th></tr></thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.NombreCompleto <br /><small class="text-muted">@user.Email</small></td>
                                <td>
                                    <form asp-action="AsignarRol" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <select name="roleName" class="form-select form-select-sm">
                                            @foreach (var role in roles)
                                            {
                                                var selected = user.Email == "admin@iue.edu.co" && role.Name == "Admin" ? "selected" : string.Empty;
                                                <option value="@role.Name" selected="@selected">@role.Name</option>
                                            }
                                        </select>
                                        <button class="btn btn-sm btn-primary">Guardar</button>
                                    </form>
                                </td>
                                <td></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="app-card p-4 h-100">
            <h5 class="mb-3"><i class="bi bi-book-half me-2 text-info"></i>Asignar profesores a materias</h5>
            <div class="vstack gap-3">
                @foreach (var materia in materias)
                {
                    <form asp-action="AsignarProfesorMateria" method="post" class="border rounded-4 p-3">
                        <input type="hidden" name="materiaId" value="@materia.Id" />
                        <div class="d-flex justify-content-between gap-3 align-items-center flex-wrap">
                            <div>
                                <strong>@materia.Nombre</strong><br />
                                <small class="text-muted">@((materia.Profesor?.NombreCompleto) ?? "Sin profesor asignado")</small>
                            </div>
                            <select name="profesorId" class="form-select form-select-sm" style="max-width: 240px;">
                                <option value="">Sin asignar</option>
                                @foreach (var profesor in profesores)
                                {
                                    var selected = materia.ProfesorId == profesor.Id ? "selected" : string.Empty;
                                    <option value="@profesor.Id" selected="@selected">@profesor.NombreCompleto (@profesor.Email)</option>
                                }
                            </select>
                            <button class="btn btn-sm btn-outline-primary">Guardar</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
