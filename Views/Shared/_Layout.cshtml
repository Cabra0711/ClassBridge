<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — IUE Desatrasador</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background-color: #f4f6fb; }
        .navbar-brand { font-weight: 700; letter-spacing: 1px; }
        .sidebar { min-height: calc(100vh - 56px); background: #1a2340; }
        .sidebar .nav-link { color: #b0bec5; padding: .65rem 1.25rem; border-radius: 8px; margin: 2px 8px; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background: #2d3f6b; color: #fff; }
        .sidebar .nav-link i { width: 22px; }
        .sidebar .section-label { color: #546e7a; font-size: .7rem; text-transform: uppercase;
                                   letter-spacing: 1px; padding: .5rem 1.25rem; margin-top: .5rem; }
        .main-content { padding: 2rem; }
        .card { border: none; border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,.07); }
        .card-header { border-radius: 14px 14px 0 0 !important; }
        .badge-estado-Aprobada  { background-color: #d1fae5; color: #065f46; }
        .badge-estado-Pendiente { background-color: #fef9c3; color: #854d0e; }
        .badge-estado-Rechazada { background-color: #fee2e2; color: #991b1b; }
    </style>
</head>
<body>
<nav class="navbar navbar-dark bg-primary px-3">
    <a class="navbar-brand" href="/"><i class="bi bi-mortarboard-fill me-2"></i>IUE Desatrasador</a>
    <div class="d-flex align-items-center gap-3">
        <partial name="_LoginPartial" />
        <span class="text-white-50 small">MVP v1.0</span>
    </div>
</nav>

<div class="d-flex">
    <!-- Sidebar -->
    <div class="sidebar d-none d-md-block" style="width:220px; flex-shrink:0;">
        <div class="pt-3">
            @if (User.IsInRole("Admin") || User.IsInRole("Estudiante"))
            {
                <div class="section-label">Estudiante</div>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Clase/Dashboard") ? "active" : "")"
                   href="/Clase/Dashboard/1">
                    <i class="bi bi-grid-fill"></i> Dashboard
                </a>
            }

            @if (User.IsInRole("Admin") || User.IsInRole("Profesor"))
            {
                <div class="section-label mt-2">Profesor</div>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Profesor") ? "active" : "")"
                   href="/Profesor">
                    <i class="bi bi-person-workspace"></i> Panel Profesor
                </a>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Clase/CreateVideo") ? "active" : "")"
                   href="/Clase/CreateVideo">
                    <i class="bi bi-camera-video-fill"></i> Subir Video
                </a>
            }

            @if (User.IsInRole("Admin"))
            {
                <div class="section-label mt-2">Administración</div>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin") ? "active" : "")"
                   href="/Admin">
                    <i class="bi bi-shield-lock-fill"></i> Admin
                </a>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Clase/Excusas") ? "active" : "")"
                   href="/Clase/Excusas">
                    <i class="bi bi-file-earmark-check-fill"></i> Excusas
                </a>
            }
        </div>
    </div>

    <!-- Content -->
    <div class="main-content flex-grow-1">
        @RenderBody()
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
