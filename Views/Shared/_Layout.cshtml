<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — IUE Desatrasador</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --accent: #14b8a6;
            --surface: #ffffff;
            --surface-soft: #f8fbff;
            --text: #10213a;
            --muted: #6b7a90;
        }

        body {
            background: linear-gradient(135deg, #f3f7ff 0%, #eef4ff 100%);
            color: var(--text);
            font-family: "Segoe UI", Inter, Roboto, Arial, sans-serif;
        }

        .navbar {
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 100%) !important;
            box-shadow: 0 12px 30px rgba(37, 99, 235, 0.18);
            padding: 0.8rem 1rem;
        }

        .navbar-brand {
            font-weight: 700;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 0.55rem;
        }

        .brand-pill {
            background: rgba(255,255,255,0.16);
            border: 1px solid rgba(255,255,255,0.2);
            padding: 0.25rem 0.7rem;
            border-radius: 999px;
            font-size: 0.82rem;
        }

        .sidebar {
            min-height: calc(100vh - 56px);
            width: 240px;
            flex-shrink: 0;
            background: linear-gradient(180deg, #111827 0%, #1f2937 100%);
            border-right: 1px solid rgba(255,255,255,0.05);
        }

        .sidebar .nav-link {
            color: #c7d2fe;
            padding: 0.7rem 1.15rem;
            border-radius: 12px;
            margin: 2px 10px;
            transition: all 0.2s ease;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background: rgba(37, 99, 235, 0.25);
            color: #fff;
            transform: translateX(2px);
        }

        .sidebar .nav-link i { width: 22px; }
        .sidebar .section-label {
            color: #98a2b3;
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 0.45rem 1.2rem;
            margin-top: 0.35rem;
        }

        .main-content {
            padding: 1.5rem 1.4rem 2rem;
        }

        .app-card,
        .card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 12px 35px rgba(15, 23, 42, 0.07);
            background: var(--surface);
        }

        .card-header {
            border-radius: 20px 20px 0 0 !important;
            border-bottom: 1px solid #eef3ff;
        }

        .page-hero {
            background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 50%, #3b82f6 100%);
            color: white;
            border-radius: 24px;
            padding: 1.6rem 1.7rem;
            box-shadow: 0 18px 40px rgba(37, 99, 235, 0.2);
        }

        .stat-card {
            background: linear-gradient(135deg, #ffffff 0%, #f7fbff 100%);
            border: 1px solid #e7efff;
            border-radius: 18px;
            min-height: 118px;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
        }

        .form-control, .form-select, textarea {
            border-radius: 14px;
            border: 1px solid #dbe8ff;
            padding: 0.75rem 0.9rem;
            box-shadow: none;
        }

        .form-control:focus, .form-select:focus, textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.16);
        }

        .btn {
            border-radius: 999px;
            padding: 0.72rem 1.12rem;
            font-weight: 600;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary) 0%, #3b82f6 100%);
            border: none;
        }

        .btn-success {
            background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
            border: none;
        }

        .badge-estado-Aprobada { background-color: #d1fae5; color: #065f46; }
        .badge-estado-Pendiente { background-color: #fef9c3; color: #854d0e; }
        .badge-estado-Rechazada { background-color: #fee2e2; color: #991b1b; }

        .table-modern th {
            background: #f5f8ff;
            color: #4b5f79;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
    </style>
</head>
<body>
<nav class="navbar navbar-dark px-3">
    <a class="navbar-brand" href="/"><i class="bi bi-mortarboard-fill"></i>IUE Desatrasador</a>
    <div class="d-flex align-items-center gap-3">
        <partial name="_LoginPartial" />
        <span class="brand-pill">MVP v1.0</span>
    </div>
</nav>

<div class="d-flex">
    <div class="sidebar d-none d-md-block">
        <div class="pt-3">
            @if (User.IsInRole("Admin") || User.IsInRole("Estudiante"))
            {
                <div class="section-label">Estudiante</div>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Clase/Dashboard") ? "active" : "")"
                   href="/Clase/Dashboard/1">
                    <i class="bi bi-grid-fill"></i> Dashboard
                </a>
            }

            @if (User.IsInRole("Admin") || User.IsInRole("Profesor"))
            {
                <div class="section-label mt-2">Profesor</div>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Profesor") ? "active" : "")"
                   href="/Profesor">
                    <i class="bi bi-person-workspace"></i> Panel Profesor
                </a>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Clase/CreateVideo") ? "active" : "")"
                   href="/Clase/CreateVideo">
                    <i class="bi bi-camera-video-fill"></i> Subir Video
                </a>
            }

            @if (User.IsInRole("Admin"))
            {
                <div class="section-label mt-2">Administración</div>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin") ? "active" : "")"
                   href="/Admin">
                    <i class="bi bi-shield-lock-fill"></i> Admin
                </a>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Clase/Excusas") ? "active" : "")"
                   href="/Clase/Excusas">
                    <i class="bi bi-file-earmark-check-fill"></i> Excusas
                </a>
            }
        </div>
    </div>

    <div class="main-content flex-grow-1">
        @RenderBody()
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
