@{
    ViewData["Title"] = "Panel del profesor";
    var clases = (IEnumerable<IUE.DesatrasadorMVP.Models.Clase>)ViewBag.Clases;
}
<div class="row g-4">
    <div class="col-12">
        <div class="page-hero">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <span class="badge bg-white text-primary mb-3">Panel del profesor</span>
                    <h3 class="mb-2">Gestiona tus clases y comparte contenido con tus estudiantes</h3>
                    <p class="mb-0 opacity-75">Sube videos, organiza tus clases y mantén un seguimiento claro del proceso.</p>
                </div>
                <div class="text-white-50 small">@clases.Count() clases disponibles</div>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="app-card p-4 h-100">
            <h5 class="mb-3"><i class="bi bi-lightning-charge-fill me-2 text-warning"></i>Acciones rápidas</h5>
            <div class="border rounded-4 p-4 bg-light">
                <p class="text-muted mb-3">Comparte la grabación de una clase o actualiza el contenido disponible para tus estudiantes.</p>
                <a class="btn btn-primary" asp-controller="Clase" asp-action="CreateVideo">Subir / actualizar video</a>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="app-card p-4 h-100">
            <h5 class="mb-3"><i class="bi bi-collection-play-fill me-2 text-primary"></i>Clases disponibles</h5>
            <div class="vstack gap-2">
                @foreach (var clase in clases)
                {
                    <div class="border rounded-4 p-3">
                        <strong>@clase.Materia.Nombre</strong><br />
                        <small class="text-muted">@clase.Titulo</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
