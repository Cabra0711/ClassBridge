@{
    ViewData["Title"] = "Panel del profesor";
    var clases = (IEnumerable<IUE.DesatrasadorMVP.Models.Clase>)ViewBag.Clases;
}
<div class="row g-4">
    <div class="col-12">
        <div class="card p-4">
            <h3 class="mb-2">Panel del profesor</h3>
            <p class="text-muted mb-0">Desde aquí puedes subir videos para tus clases y mantener el flujo de desatraso.</p>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card p-4">
            <h5 class="mb-3">Acciones rápidas</h5>
            <a class="btn btn-primary" asp-controller="Clase" asp-action="CreateVideo">Subir / actualizar video</a>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card p-4">
            <h5 class="mb-3">Clases disponibles</h5>
            <div class="vstack gap-2">
                @foreach (var clase in clases)
                {
                    <div class="border rounded p-3">
                        <strong>@clase.Materia.Nombre</strong><br />
                        <small class="text-muted">@clase.Titulo</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
