@{
    ViewData["Title"] = "Enviar excusa";
    var clase = (IUE.DesatrasadorMVP.Models.Clase)ViewBag.Clase;
    var estudiante = (IUE.DesatrasadorMVP.Models.Estudiante)ViewBag.Estudiante;
}

<div class="row justify-content-center py-2">
    <div class="col-lg-8">
        <div class="page-hero mb-4">
            <h3 class="mb-2"><i class="bi bi-envelope-paper-fill me-2"></i>Enviar excusa</h3>
            <p class="mb-0 opacity-75">Registra una solicitud para la clase seleccionada y espera la revisión del administrador.</p>
        </div>

        <div class="app-card p-4 p-lg-5">
            <div class="border rounded-4 p-4 mb-4 bg-light">
                <div class="fw-semibold">@clase.Materia.Nombre</div>
                <div class="text-muted">@clase.Titulo</div>
                <div class="small text-muted mt-2">Estudiante: @estudiante.Nombre</div>
            </div>

            <form asp-action="EnviarExcusa" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="claseId" value="@clase.Id" />
                <input type="hidden" name="estudianteId" value="@estudiante.Id" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Descripción de la excusa</label>
                    <textarea name="descripcion" class="form-control" rows="5" placeholder="Explica brevemente el motivo de tu solicitud..." required></textarea>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-warning">Enviar solicitud</button>
                    <a asp-action="Dashboard" asp-route-id="@estudiante.Id" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
