@model IEnumerable<Excusa>
@{
    ViewData["Title"] = "Gestión de Excusas";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h3 class="mb-0"><i class="bi bi-file-earmark-check-fill me-2 text-primary"></i>Gestión de Excusas</h3>
    <span class="badge bg-primary fs-6">@Model.Count() total</span>
</div>

@if (!Model.Any())
{
    <div class="app-card text-center py-5">
        <div class="card-body">
            <i class="bi bi-inbox text-muted" style="font-size:3rem"></i>
            <h5 class="mt-3 text-muted">No hay excusas registradas</h5>
        </div>
    </div>
}
else
{
    <div class="app-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 table-modern">
                    <thead>
                        <tr>
                            <th>Estudiante</th>
                            <th>Materia / Clase</th>
                            <th>Descripción</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th class="text-center">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var excusa in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@excusa.Estudiante.Nombre</strong><br />
                                    <small class="text-muted">@excusa.Estudiante.Correo</small>
                                </td>
                                <td>
                                    <span class="text-primary">@excusa.Clase.Materia.Nombre</span><br />
                                    <small>@excusa.Clase.Titulo</small>
                                </td>
                                <td>@(excusa.Descripcion ?? "—")</td>
                                <td class="text-nowrap">@excusa.FechaEnvio.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge badge-estado-@excusa.Estado px-3 py-2">@excusa.Estado</span>
                                </td>
                                <td class="text-center">
                                    @if (excusa.Estado == EstadoExcusa.Pendiente)
                                    {
                                        <div class="d-flex gap-1 justify-content-center">
                                            <form asp-action="CambiarEstadoExcusa" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="excusaId" value="@excusa.Id" />
                                                <input type="hidden" name="estado" value="@((int)EstadoExcusa.Aprobada)" />
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="bi bi-check-lg"></i> Aprobar
                                                </button>
                                            </form>
                                            <form asp-action="CambiarEstadoExcusa" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="excusaId" value="@excusa.Id" />
                                                <input type="hidden" name="estado" value="@((int)EstadoExcusa.Rechazada)" />
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-x-lg"></i> Rechazar
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Procesada</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
