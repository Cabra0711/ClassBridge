@model Clase
@{
    ViewData["Title"] = Model.Titulo;
    bool excusaAprobada = (bool)ViewBag.ExcusaAprobada;
    int estudianteId    = (int)ViewBag.EstudianteId;

    string embedUrl = "";
    if (Model.VideoClase != null)
    {
        var url = Model.VideoClase.VideoUrl.Trim();

        if (url.Contains("youtube.com/watch"))
        {
            var uri     = new Uri(url);
            var videoId = System.Web.HttpUtility.ParseQueryString(uri.Query)["v"];
            embedUrl = $"https://www.youtube.com/embed/{videoId}?rel=0&modestbranding=1";
        }
        else if (url.Contains("youtu.be/"))
        {
            var videoId = url.Split('/').Last().Split('?').First();
            embedUrl = $"https://www.youtube.com/embed/{videoId}?rel=0&modestbranding=1";
        }
        else if (url.Contains("drive.google.com"))
        {
            embedUrl = url.Replace("/view", "/preview").Replace("/edit", "/preview");
        }
        else if (url.Contains("vimeo.com"))
        {
            var vimeoId = url.Split('/').Last();
            embedUrl = $"https://player.vimeo.com/video/{vimeoId}";
        }
        else
        {
            embedUrl = url;
        }
    }
}

<div class="row">
    <div class="col-12">
        <a href="/Clase/Dashboard/@estudianteId" class="btn btn-outline-secondary btn-sm mb-3">
            <i class="bi bi-arrow-left"></i> Volver al Dashboard
        </a>

        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0">@Model.Titulo</h5>
                        <small class="opacity-75">@Model.Materia.Nombre · @Model.FechaClase.ToString("dd 'de' MMMM yyyy")</small>
                    </div>
                    @if (excusaAprobada)
                    {
                        <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Excusa Aprobada</span>
                    }
                </div>
            </div>

            <div class="card-body p-0">
                @if (!excusaAprobada)
                {
                    <div class="text-center py-5 px-4">
                        <i class="bi bi-lock-fill text-warning" style="font-size:3rem"></i>
                        <h4 class="mt-3 text-warning">Acceso Restringido</h4>
                        <p class="text-muted">Tu excusa para esta clase aún está <strong>pendiente de aprobación</strong>.<br />
                        Cuando el profesor apruebe tu excusa, podrás ver el video aquí.</p>
                        <a href="/Clase/Dashboard/@estudianteId" class="btn btn-primary mt-2">Volver al Dashboard</a>
                    </div>
                }
                else if (Model.VideoClase == null)
                {
                    <div class="text-center py-5 px-4">
                        <i class="bi bi-camera-video-off text-secondary" style="font-size:3rem"></i>
                        <h4 class="mt-3 text-muted">Video no disponible</h4>
                        <p class="text-muted">El profesor aún no ha subido el video de esta clase.</p>
                    </div>
                }
                else
                {
                    <!-- Video embebido -->
                    <div class="ratio ratio-16x9">
                        <iframe src="@embedUrl"
                                title="@Model.Titulo"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen>
                        </iframe>
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Resumen) && excusaAprobada)
        {
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-journal-text me-2"></i>Resumen de la Clase</h6>
                </div>
                <div class="card-body">
                    <p class="mb-0">@Model.Resumen</p>
                </div>
            </div>
        }
    </div>
</div>
